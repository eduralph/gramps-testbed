{
  "version": "2.0.0",
  "// ": "dev-tooling analyzer tasks. Run from the gramps-testbed root (${workspaceFolder}).",
  "// 2": "All target the SIBLING ../gramps fork. These invoke the EXPERIMENT configs explicitly",
  "// 3": "via --project/--config so they never disturb Pylance's normal in-editor analysis of",
  "// 4": "the testbed's own Python. Findings land in the Problems panel via the matchers below.",
  "tasks": [
    {
      "label": "dev-tooling: pyright (scoped None-flow)",
      "type": "shell",
      "command": "pyright",
      "args": [
        "--project",
        "agent-work/dev-tooling/pyright/pyrightconfig.experiment.json"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": {
        "owner": "pyright-scoped",
        "source": "pyright",
        "// ": "pyright emits ABSOLUTE paths: '  /abs/path.py:LINE:COL - severity: message (rule)'",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^\\s+(.*\\.py):(\\d+):(\\d+)\\s+-\\s+(error|warning|information):\\s+(.*?)(?:\\s+\\((\\w+)\\))?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      }
    },
    {
      "label": "dev-tooling: semgrep (gramps shape patterns)",
      "type": "shell",
      "command": "semgrep",
      "args": [
        "--config",
        "agent-work/dev-tooling/semgrep/rules/",
        "--emacs",
        "../gramps/gramps/gui/"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": {
        "owner": "semgrep-gramps",
        "source": "semgrep",
        "// ": "semgrep --emacs: 'file:LINE:COL:severity(rule):<code line>:<message>'. Paths are",
        "// 2": "relative to cwd (${workspaceFolder}); the ../gramps/... prefix resolves from there.",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+):(error|warning|info)\\(([^)]+)\\):(?:.*?):(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    },
    {
      "label": "dev-tooling: semgrep rule self-test",
      "type": "shell",
      "command": "semgrep",
      "args": ["--test", "--config", "rules/", "tests/"],
      "options": { "cwd": "${workspaceFolder}/agent-work/dev-tooling/semgrep" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "dev-tooling: all analyzers",
      "dependsOrder": "sequence",
      "dependsOn": [
        "dev-tooling: semgrep rule self-test",
        "dev-tooling: pyright (scoped None-flow)",
        "dev-tooling: semgrep (gramps shape patterns)"
      ],
      "problemMatcher": []
    }
  ]
}
