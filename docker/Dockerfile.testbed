# Mirrors the GitHub Actions environment so local dogtail runs match CI.
# Build:  docker build -f docker/Dockerfile.testbed -t gramps-testbed .
# Run:    see docker/run-local.sh
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GTK_MODULES=gail:atk-bridge \
    NO_AT_BRIDGE=0

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-dev \
      python3-gi python3-gi-cairo python3-cairo \
      gir1.2-gtk-3.0 gir1.2-osmgpsmap-1.0 gir1.2-goocanvas-2.0 \
      libgirepository1.0-dev \
      xvfb dbus-x11 at-spi2-core \
      xdotool wmctrl \
      gettext intltool \
      librsvg2-common \
      git curl ca-certificates \
      fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*

# dogtail/pyatspi + JUnit XML writer for unittest
RUN pip3 install --break-system-packages --no-cache-dir \
      dogtail \
      pyatspi \
      unittest-xml-reporting

WORKDIR /workspace

# Tests run as a non-root user so AT-SPI behaves normally
RUN useradd -m -u 1000 runner \
 && mkdir -p /workspace /home/runner/.gramps \
 && chown -R runner:runner /workspace /home/runner
USER runner

CMD ["/bin/bash"]
